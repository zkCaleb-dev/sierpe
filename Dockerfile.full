# The -full variant: the appliance plus a stellar-core binary, enabling the
# archive leg (heal history below RPC retention from the public archives).
#
# linux/amd64 only: SDF publishes stellar-core images for amd64 exclusively.
# On ARM hosts it runs under emulation; for archive-less deployments use the
# slim image (Dockerfile), which is multi-arch and distroless.

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/sierpe ./cmd/sierpe

# The runtime base ships /usr/bin/stellar-core with its shared libraries;
# sierpe rides along and spawns core as a captive subprocess.
#
# Pinned to an exact build, not the floating `28` tag. That tag moves: it
# served 28.0.0 when the mainnet pilot deployed and 28.0.1 days later, so
# the same Dockerfile produced a different replay engine depending on when
# it was built — silently, in the one image whose whole job is to
# reproduce history byte-for-byte. Bump it deliberately (RELEASING.md);
# the equivalence gate re-proves the new build on first heal.
#
# Every SDF core image reports "running non-release version", their
# `stable` tag included; it is how they build them, not a preview build.
FROM stellar/stellar-core:28.0.1-3508.947aad841.noble
# See Dockerfile: the source label is what links the package to the repo.
LABEL org.opencontainers.image.source="https://github.com/zkCaleb-dev/sierpe" \
      org.opencontainers.image.description="Self-hosted Stellar contract indexer, with stellar-core for the archive leg" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/sierpe /sierpe
ENV STELLAR_CORE_BINARY=/usr/bin/stellar-core
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["/sierpe", "healthcheck"]
ENTRYPOINT ["/sierpe"]
CMD ["run"]
