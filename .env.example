# Sierpe boot configuration. Copy to .env for local development.
# Hot configuration (contracts, retention) lives in the database and is
# managed through the admin API — not here.

# Required: an empty Postgres database. Sierpe owns the schema inside it.
DATABASE_URL=postgres://sierpe:sierpe@localhost:5432/sierpe?sslmode=disable

# Required: testnet | mainnet
NETWORK=testnet

# Required: gates the admin API. Minimum 16 characters, 6 distinct.
ADMIN_TOKEN=change-me-to-something-long-and-random

# Optional: comma-separated RPC failover pool, in order of preference.
# Default on testnet: https://soroban-testnet.stellar.org
# Required on mainnet (there is no default public mainnet RPC).
#RPC_URLS=https://soroban-testnet.stellar.org

# Optional: HTTP port for the API and health endpoints (default 8080).
#HTTP_PORT=8080

# Optional: first ledger to ingest on a fresh database (default: current tip).
#START_LEDGER=
