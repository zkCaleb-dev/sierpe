{
  "title": "Sierpe",
  "uid": "sierpe-overview",
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tip lag",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sierpe_tip_lag_seconds", "legendFormat": "lag", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open gaps",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sierpe_open_gaps", "legendFormat": "gaps", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pending backfills",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "sierpe_backfill_pending", "legendFormat": "pending", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Suppressed (should be 0)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sierpe_suppressed_txs_total", "legendFormat": "txs", "refId": "A" },
        { "expr": "sierpe_suppressed_events_total", "legendFormat": "records", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ledgers ingested / s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(sierpe_ledgers_ingested_total[5m])", "legendFormat": "live", "refId": "A" },
        { "expr": "rate(sierpe_backfill_ledgers_scanned_total[5m])", "legendFormat": "backfill", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Records extracted / s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(sierpe_events_extracted_total[5m])", "legendFormat": "events", "refId": "A" },
        { "expr": "rate(sierpe_state_changes_extracted_total[5m])", "legendFormat": "state changes", "refId": "B" },
        { "expr": "rate(sierpe_failed_txs_skipped_total[5m])", "legendFormat": "failed txs skipped", "refId": "C" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Commit duration p50 / p99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(sierpe_commit_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sierpe_commit_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Source failovers",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "increase(sierpe_source_failovers_total[5m])", "legendFormat": "failovers / 5m", "refId": "A" }
      ]
    }
  ]
}
